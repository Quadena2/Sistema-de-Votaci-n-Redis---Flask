# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo a `.env` y reemplaza los valores por tus propios secretos.
# ==============================================================================

# Clave secreta para firmar criptográficamente la sesión de Flask y tokens CSRF
FLASK_CLAVE_SECRETA=cambiar-por-una-clave-secreta-larga-y-aleatoria

# Activar modo de depuración de Flask (true o false). En producción debe ser false.
FLASK_DEPURACION=false

# Código privado requerido para registrar nuevas cuentas de administrador
CODIGO_INVITACION_ADMIN=cambiar-por-un-codigo-privado

# URL de conexión al servidor Redis (ejecutándose en el contenedor Docker existente)
REDIS_URL=redis://localhost:6379/0

# Prefijo de espacio de nombres para todas las claves de la aplicación en Redis
PREFIJO_REDIS=votacion

# Entorno de ejecución: desarrollo, pruebas o produccion
ENTORNO=desarrollo

# Límite de intentos fallidos de inicio de sesión antes de bloqueo temporal
MAX_INTENTOS_LOGIN=5
VENTANA_BLOQUEO_LOGIN_SEGUNDOS=300
